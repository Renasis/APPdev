rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isStaff() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    match /products/{productId} {
      allow read: if isAdmin() || isStaff() || isSignedIn();
      allow write: if isAdmin();
    }

    match /inventory/{inventoryId} {
      allow read: if isAdmin() || isStaff();
      allow create: if isAdmin() || isStaff();
      allow update: if isAdmin() || isStaff();
      allow delete: if isAdmin();
    }

    match /stock_movements/{movementId} {
      allow read: if isAdmin() || isStaff();
      allow create: if isAdmin() || isStaff()
        && request.resource.data.performedByUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || isStaff() || 
        (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid;
      allow update: if isAdmin() || isStaff() || 
        (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    function hasPendingStaffInvitation() {
      return isSignedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/staffInvitations/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/staffInvitations/$(request.auth.token.email.lower())).data.status == 'pending';
    }

    match /users/{userId} {
      allow list: if isAdmin() || isStaff();
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isAdmin() || isStaff());
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && (
          request.resource.data.role == 'customer'
          || (
            request.resource.data.role == 'staff'
            && request.resource.data.isActive == true
            && request.resource.data.status == 'active'
            && hasPendingStaffInvitation()
          )
        );
      allow update: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.isActive == resource.data.isActive
      );
      allow delete: if isAdmin();
    }

    match /staffInvitations/{invitationId} {
      // Only admins can create invitations.
      allow create: if isAdmin();

      // Only admins can list all invitations.
      allow list: if isAdmin();

      // Admins can read any invitation.
      allow read: if isAdmin();

      // An invited user can read their own invitation.
      // The invitation ID is the normalized email address.
      allow get: if isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == invitationId;

      // Admins can update any invitation.
      //
      // An invited user may update only their own pending invitation to
      // accept it. They cannot change privileged fields such as name,
      // email, phone, or role.
      allow update: if isAdmin() || (
        isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == invitationId
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == resource.data.name
        && request.resource.data.email == resource.data.email
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.role == resource.data.role
      );

      // Only admins can delete invitations.
      allow delete: if isAdmin();
    }

    match /suppliers/{supplierId} {
      // Only admins can manage suppliers.
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /purchase_orders/{orderId} {
      // Only admins can manage purchase orders.
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      // Only admins can read and write settings.
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.recipientUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.recipientUid == request.auth.uid);
    }

    match /walkInSales/{saleId} {
      allow read: if isAdmin() || isStaff();
      allow create: if isAdmin() || isStaff();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /supportInquiries/{inquiryId} {
      allow read: if isAdmin() || isStaff() ||
        (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid;
      allow update: if isAdmin() || isStaff() && request.resource.data.customerId == resource.data.customerId
        || (isSignedIn() && resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.subject == resource.data.subject
          && request.resource.data.message == resource.data.message
          && request.resource.data.category == resource.data.category);
      allow delete: if isAdmin();
    }
  }
}